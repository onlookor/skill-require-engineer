{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReBaselineArtifact",
  "description": "Baselined requirements set produced by release_manager under Rule: validation_report -> re_baseline. Becomes the precondition for downstream lifecycle phases (architecture, implementation, test) in the PACT instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_version", "baseline_date", "requirement_items"],
  "properties": {
    "baseline_version": {"type": "string"},
    "baseline_date": {"type": "string", "description": "YYYY-MM-DD."},
    "approved_by": {"type": "array", "items": {"type": "string"}},
    "requirement_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "ears_type", "statement"],
        "properties": {
          "id": {"type": "string", "description": "Unique persistent identifier (traceability precondition)."},
          "version": {"type": "string", "description": "Item-level version, e.g. v1.2.0."},
          "status": {
            "type": "string",
            "enum": ["draft", "proposed", "approved", "implemented", "verified", "released", "rejected", "deferred"]
          },
          "source": {"type": "string", "description": "Origin: interview / observation / document + date."},
          "ears_type": {"type": "string", "enum": ["ubiquitous", "event", "state", "unwanted", "optional"]},
          "statement": {"type": "string", "description": "EARS statement (validated by ears_regex.yaml)."},
          "traces_to": {"type": "array", "items": {"type": "string"}, "description": "Upward links (business goals)."},
          "traced_from": {"type": "array", "items": {"type": "string"}, "description": "Downward links (design / code / test) filled by downstream phases."},
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["given", "when", "then"],
              "properties": {
                "given": {"type": "string"},
                "when": {"type": "string"},
                "then": {"type": "string"}
              }
            }
          },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "date", "author", "reason"],
              "properties": {
                "version": {"type": "string"},
                "date": {"type": "string"},
                "author": {"type": "string"},
                "reason": {"type": "string"},
                "approved_by": {"type": "string"}
              }
            }
          },
          "quality_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "Composite specification-quality score."},
          "pact_token_ref": {"type": "string", "description": "PACT embedded mode: the depends_on chain of the owning Token."}
        }
      }
    }
  }
}
